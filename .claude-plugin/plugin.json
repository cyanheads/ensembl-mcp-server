{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "ensembl-mcp-server",
  "version": "0.7.1",
  "description": "Look up genes, fetch sequences, predict variant consequences, find orthologs, and retrieve cross-database xrefs from Ensembl REST via MCP. STDIO or Streamable HTTP.",
  "author": {
    "name": "cyanheads",
    "email": "casey@caseyjhand.com",
    "url": "https://github.com/cyanheads"
  },
  "homepage": "https://github.com/cyanheads/ensembl-mcp-server#readme",
  "repository": "https://github.com/cyanheads/ensembl-mcp-server",
  "license": "Apache-2.0",
  "keywords": [
    "ensembl",
    "genomics",
    "bioinformatics",
    "genes",
    "sequences",
    "variants",
    "mcp",
    "mcp-server",
    "model-context-protocol"
  ],
  "userConfig": {
    "clamp_limits": {
      "type": "boolean",
      "title": "Clamp oversized page requests",
      "description": "Clamp an ensembl_query_region max_results above 5,000 to 5,000 with a notice. Turn off to reject larger values instead.",
      "default": true
    }
  },
  "mcpServers": {
    "ensembl-mcp-server": {
      "command": "npx",
      "args": ["-y", "@cyanheads/ensembl-mcp-server"],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio",
        "ENSEMBL_CLAMP_LIMITS": "${user_config.clamp_limits}"
      }
    }
  }
}
