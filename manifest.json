{
  "manifest_version": "0.3",
  "name": "ensembl-mcp-server",
  "version": "0.7.2",
  "description": "Look up genes, sequences, variants, homologs, and cross-database xrefs from Ensembl REST.",
  "author": { "name": "cyanheads" },
  "repository": {
    "type": "git",
    "url": "https://github.com/cyanheads/ensembl-mcp-server"
  },
  "homepage": "https://github.com/cyanheads/ensembl-mcp-server#readme",
  "license": "Apache-2.0",
  "server": {
    "type": "node",
    "entry_point": "dist/index.js",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/dist/index.js"],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio",
        "MCP_AUTH_MODE": "none",
        "NODE_ENV": "production",
        "ENSEMBL_CLAMP_LIMITS": "${user_config.clamp_limits}"
      }
    }
  },
  "compatibility": {
    "runtimes": { "node": ">=24.0.0" }
  },
  "tools_generated": true,
  "prompts_generated": true,
  "user_config": {
    "clamp_limits": {
      "type": "boolean",
      "title": "Clamp oversized page requests",
      "description": "Clamp an ensembl_query_region max_results above 5,000 to 5,000 with a notice. Turn off to reject larger values instead.",
      "default": true,
      "required": false
    }
  }
}
